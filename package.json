{
  "name": "filpgf-agent-kit",
  "version": "0.3.0",
  "private": true,
  "description": "FilPGF Agent Kit: a Filecoin public goods funding plugin for Claude Code, Codex, Pi and other agents. This package is also the Pi package.",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/filecoin-project/filpgf-agent-kit",
  "keywords": [
    "pi-package",
    "filecoin",
    "filpgf",
    "public-goods",
    "karma",
    "artio",
    "fdp",
    "filoscope",
    "agent-skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "skills": [
      "./plugins/filpgf-ecosystem/skills"
    ],
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "sync": "node scripts/sync-skills.mjs",
    "sync:check": "node scripts/sync-skills.mjs --check",
    "imports:pin": "node scripts/pin-imports.mjs",
    "imports:update": "node scripts/update-imports.mjs && node scripts/sync-skills.mjs",
    "smoke": "sh scripts/smoke.sh",
    "version": "node scripts/check.mjs --set-version && git add plugins/filpgf-ecosystem"
  }
}
