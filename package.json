{
  "name": "filpgf-agent-kit",
  "version": "0.3.0",
  "private": true,
  "description": "Builds the FilPGF Agent Kit plugin and the stable marketplace branch for Claude Code, Codex, Pi and other agent clients.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build.mjs --no-imports",
    "validate": "node scripts/validate-dist.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "smoke": "sh scripts/smoke.sh",
    "imports:pin": "node scripts/pin-imports.mjs",
    "imports:check": "node scripts/pin-imports.mjs --check",
    "imports:update": "node scripts/update-imports.mjs"
  }
}
